        eigval<-eigen(cov)$values  #eigenvalues
        K_est<-which.min(diff(log(eigval[1:10]))) #estimate factor numbers using eigenvalue ratios.
        rr_hat[k]=K_est
        hatf2<-Re(sqrt(n)*eigvec[,1:K_est]) #estimated factors
        hatf_all=cbind(hatf_all,hatf2)
        hatB2<-t(1/n*t(hatf2)%*%XX[[k]]) #Estimated Factor Loading
        if(k==1){
          hatB2_li=hatB2
        }else{
          # hatB2    <- Re(hatB2)
          hatB2_li=as.matrix(bdiag(hatB2_li,hatB2))
        }
        tmp=XX[[k]]-hatf2%*%t(hatB2)
        hatU2<-cbind(hatU2,tmp)   #Estimated Idiosyncratic component
      }
      penalty_factors1=c(rep(0,dim(hatf_all)[2]),rep(1,p))
      cvfit4 <- cv.ncvreg(cbind(hatf_all,hatU2),Y,penalty.factor = penalty_factors1, penalty="MCP")#,intercept = FALSE
      fit4 <- cvfit4$fit
      cv_res4<-fit4$beta[,cvfit4$min]
      beta_hat8=cv_res4[(dim(hatf_all)[2]+2):(dim(hatf_all)[2]+p+1)]
      gamma_hat8=cv_res4[2:(dim(hatf_all)[2]+1)]
      names(gamma_hat8)=rep(1:K,rr_hat)


       dis7_1<-c(dis7_1,sqrt(sum((beta_hat8-beta)^2)))

      #-----------test----------
      n_test <- 100
      # ======== F_test ========
      if (choose_F == 1) {
        F_test <- matrix(rnorm(n_test * r_all), nrow = n_test)
      } else {
        F_start <- F_origin
        F_test <- matrix(nrow = n_test, ncol = r_all)
        for (t in 1:n_test) {
          F_start <- Phi %*% F_start + rnorm(r_all)
          F_test[t, ] <- F_start
        }
      }

      # ========  V_test ========
      if (choose_V == 1) {
        V_test <- matrix(rnorm(n_test * p), nrow = n_test)
      } else{
        V_test <- mvrnorm(n_test, rep(0, p), top_mat)
      }


      # ======== X_test Y_test ========
      X_test <- F_test %*% t(B) + V_test
      if(choose_noise==1){
        Y_test=F_test%*%gamma1+V_test%*%beta+rnorm(n_test,mean=0,sd=1) #Data is generated following Gaussian noise
      }else if (choose_noise==2){
        Y_test=F_test%*%gamma1+V_test%*%beta+runif(n_test,-sqrt(3),sqrt(3))
      }



      #----predition of ours---------
      loading_mat=cbind(loading_c_mat,loading_s_mat)
      BtB_inv <- solve(t(loading_mat) %*% loading_mat)       # (B^T B)^{-1}
      projection <- BtB_inv %*% t(loading_mat)     # (B^T B)^{-1} B^T
      F_hat <- X_test %*% t(projection)       #   f_t^T
      V_hat <- X_test - F_hat%*%t(loading_mat)
      y_predict=V_hat%*%beta_hat1+F_hat%*%gamma_hat1
      test_error1=mean((Y_test-y_predict)^2)




      #--------MCP prediction---------
      y_predict=X_test%*%beta_hat6
