library(here)
get_project_tree <- function(path, prefix = "", depth = 0, max_depth = 5) {
if (depth > max_depth) return(invisible(NULL))
items <- list.files(
path,
full.names = TRUE,
all.files = FALSE
)
items <- items[
dir.exists(items) |
grepl("\\.R$", items, ignore.case = TRUE) |
basename(items) == "README.Rmd"
]
items <- items[
!basename(items) %in% c(".git", "renv")
]
for (i in seq_along(items)) {
is_last <- i == length(items)
cat(
prefix,
ifelse(is_last, "└── ", "├── "),
basename(items[i]),
"\n",
sep = ""
)
if (dir.exists(items[i])) {
get_project_tree(
items[i],
paste0(prefix, ifelse(is_last, "    ", "│   ")),
depth + 1,
max_depth
)
}
}
}
