cat(" - choose_B =", choose_B, "(1 = Gaussian, 2 = Uniform)\n")






set.seed(1)
K=4
r_f=c(2,rep(2,K))
r_all=sum(r_f)
pm=rep(p/K,K)
gamma1=rep(0.5,r_all)
beta=c(rep(0.5,2),rep(0,pm[1]-2),rep(0.5,2),rep(0,pm[2]-2),rep(0.5,2),rep(0,pm[3]-2),rep(0.5,2),rep(0,pm[4]-2)) #generate true beta


if(choose_V==2){
  ## v2
  top_mat <- diag(1,p)
  for(i in 1:(p-1)){
    top_mat[i, i+1] <- .2
    top_mat[i+1, i] <- .2
  }
}else if(choose_V==3){
  top_mat<-matrix(nrow=p,ncol=p) #covariance matrix
  for (i in c(1:p)){
    for (j in c(1:p)){
      top_mat[i,j]=0.2^abs(i-j)
    }
  }
}



if(choose_B==1){
  B_c<-matrix(rnorm(p*r_f[1]),nrow=p) #generate common factor loading or using gaussian.
}else{
  B_c<-matrix(runif(p*r_f[1],-sqrt(3),sqrt(3)),nrow=p) #generate common factor loading or using gaussian.
}
B_c[,1]<-B_c[,1]/(p^(1/10))

B=B_c
B_s<-list()

if(choose_B==1){
  for(k in 1:K){
    B_s[[k]]<-matrix(rnorm(pm[k]*r_f[k+1],mean = 1),nrow=pm[k])  #generate weak factor loading or using gaussian.
    B_s[[k]][,1]<- B_s[[k]][,1]/(p^(1/10))
  }
}else{
  for(k in 1:K){
    B_s[[k]]<-matrix(runif(pm[k]*r_f[k+1],(-sqrt(3)+1),(sqrt(3)+1)),nrow=pm[k])
    B_s[[k]][,1]<- B_s[[k]][,1]/(p^(1/10))
  }
}
block_diag <- as.matrix(bdiag(B_s[[1]], B_s[[2]]))
block_diag <- as.matrix(bdiag(block_diag, B_s[[3]]))
block_diag <- as.matrix(bdiag(block_diag, B_s[[4]]))

B=cbind(B_c,as.matrix(block_diag))


ratio<- seq(from = 0.2, to = 0.6, by = 0.0125)
repli=500
mat<-matrix(nrow=length(ratio),ncol=repli) #record results for proposed
mat2<-matrix(nrow=length(ratio),ncol=repli) #record results for MCP
mat7=mat6=mat5=mat3=mat4=mat2
mat_1<-matrix(nrow=length(ratio),ncol=repli) #record results for proposed
mat2_1<-matrix(nrow=length(ratio),ncol=repli) #record results for MCP
mat3_1=mat6_1=mat7_1=mat4_1=mat5_1=mat2_1


error_average=NULL

 i=0
