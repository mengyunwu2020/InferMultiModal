library(readr)
library(dplyr)
library(tidyr)
library(xtable)
library(here)
all_data=read.csv(here::here("simulation","Results","gammacsv","gammatest_mainsetting.csv"))[,-1]
plot_noise_allB_from_table <- function(noise_val, B_vals = NULL, v_vals = 1:3, F_val = NA, out_png = NULL) {
  library(ggplot2)

  sub <- all_data %>% filter(noise == noise_val)
  if (!is.null(B_vals)) {
    sub <- sub %>% filter(B %in% B_vals)
  } else {
    B_vals <- sort(unique(sub$B))
  }

  if (is.na(F_val)) {
    F_val <- unique(sub$F)[1]
  }

  df <- sub %>% filter(V %in% v_vals)

  df_sum <- df %>%
    group_by(B, V, method, k, v) %>%
    summarise(pval = mean(pval, na.rm = TRUE), .groups = "drop")

  df_sum <- df_sum %>%
    arrange(B, V, method, k, v) %>%
    group_by(B, V, method, k) %>%
    mutate(pval = cummax(pval)) %>%
    ungroup()

  v_labeller <- function(value) paste0("V", value)

  p <- ggplot(df_sum, aes(x = v, y = pval,
                          color = method,
                          shape = factor(k),
                          linetype = factor(k),
                          group = interaction(method, k))) +
    geom_line(size=0.6, na.rm = TRUE) +
    geom_point(size=2, na.rm = TRUE) +
    facet_grid(B ~ V, labeller = labeller(V = as_labeller(v_labeller))) +
    labs(
      x = expression(v),
      y = "Empirical rejection rate",
      shape = "Modality",
      linetype = "Modality",
      color = "Method"
    ) +
    theme_bw() +
    theme(
      strip.text = element_blank(),
      axis.text = element_text(size=16),
      axis.title = element_text(size=16),
      legend.key.size = unit(0.8, "lines"),
      legend.text = element_text(size=16),
      legend.title = element_text(size=16),
      legend.position = "bottom",
      legend.spacing.x = unit(0.2, "cm"),
      legend.spacing.y = unit(0.1, "cm"),
      panel.grid.minor = element_blank()
    )+
    scale_color_discrete(labels = function(x) parse(text = x))

  if(!is.null(out_png)){
    ggsave(out_png, p, width = 16, height = 9, dpi = 300)
  }

  return(p)
}






dd=plot_noise_allB_from_table(noise_val = 1, B_vals = c(1,2), out_png = paste0("Fig4.png"))
 print(dd)

 dd=plot_noise_allB_from_table(noise_val = 2, B_vals = c(1,2), out_png = paste0("FigS4.png"))
 print(dd)
