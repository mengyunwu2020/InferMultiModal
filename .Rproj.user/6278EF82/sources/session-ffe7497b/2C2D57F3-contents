      #----Fan 2024----------
      cov<-X%*%t(X)/n
      eigvec<-eigen(cov)$vectors #eigenvectors
      eigval<-eigen(cov)$values  #eigenvalues
      K_est<-which.min(diff(log(eigval[1:10]))) #estimate factor numbers using eigenvalue ratios.
      hatf2<-Re(sqrt(n)*eigvec[,1:K_est]) #estimated factors
      hatB2<-t(1/n*t(hatf2)%*%X) #Estimated Factor Loading
      hatB2_fan=hatB2
      hatU2<-X-hatf2%*%t(hatB2)   #Estimated Idiosyncratic component
      Y_1<-Y-1/n*hatf2%*%t(hatf2)%*%Y
      cvfit3 =cv.ncvreg(hatU2,Y_1,penalty="lasso")
      fit3 <- cvfit3$fit
      cv_res3<-fit3$beta[,cvfit3$min]
      beta_hat7=cv_res3[-1]
      gamma_hat7= 1/n*t(hatf2)%*%Y
      dis6_1<-c(dis6_1,sqrt(sum((beta_hat7-beta)^2)))


      #--------Li 2022---------------
      hatf_all=NULL
      hatU2=NULL
      rr_hat=rep(0,K)
      hatB2_li=NULL
      for(k in 1:K){
        cov<-XX[[k]]%*%t(XX[[k]])/n
